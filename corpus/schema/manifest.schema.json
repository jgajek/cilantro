{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CILantro corpus manifest",
  "type": "object",
  "required": ["manifestVersion", "profile", "samples"],
  "properties": {
    "manifestVersion": { "type": "integer", "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "sha256",
          "localName",
          "expectedDetection",
          "expectedCapabilities"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "tier": {
            "enum": ["profiled", "detected", "negative", "exploratory", "oracle"]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "localName": { "type": "string", "minLength": 1 },
          "expectedDetection": { "enum": ["reactor", "reactor-bootstrap", "confuserex", "none"] },
          "expectedCapabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "oracleSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedRestoredBodyCount": { "type": ["integer", "null"], "minimum": 0 },
          "maximumRemainingStubs": { "type": ["integer", "null"], "minimum": 0 },
          "minimumStringSiteCoverage": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "maximumMutationCount": { "type": ["integer", "null"], "minimum": 0 },
          "requireOracleParity": { "type": "boolean" },
          "requireOracleResourceParity": { "type": "boolean" },
          "expectedOutputSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedPayloadSha256": {
            "description": "Hashes the run must recover as payloads. The regression lock for samples whose result is a recovered stage rather than a cleaned copy.",
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "minItems": 1
          },
          "minimumBooleansRecovered": { "type": ["integer", "null"], "minimum": 0 },
          "minimumTokensRestored": { "type": ["integer", "null"], "minimum": 0 },
          "minimumResourcesRestored": { "type": ["integer", "null"], "minimum": 0 },
          "maximumRemainingSwitchDispatchers": { "type": ["integer", "null"], "minimum": 0 },
          "minimumRedirectedDispatcherEdges": { "type": ["integer", "null"], "minimum": 0 },
          "maximumUnreachableInstructions": { "type": ["integer", "null"], "minimum": 0 },
          "maximumSurplusMethods": { "type": ["integer", "null"] },
          "maximumProgramMethodSurplus": { "type": ["integer", "null"], "minimum": 0 },
          "maximumSurplusResources": { "type": ["integer", "null"] },
          "expectUnsupportedReason": { "type": ["string", "null"], "minLength": 1 },
          "minimumConstantStringSites": { "type": ["integer", "null"], "minimum": 0 },
          "minimumVirtualOperationsRead": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "minimumVirtualOperationsWalked": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "requireConsistentVirtualStack": { "type": "boolean" },
          "hostProfile": { "type": ["string", "null"], "minLength": 1 },
          "libraries": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "declarations": { "type": ["string", "null"], "minLength": 1 },
          "allowDeclaredCalls": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
