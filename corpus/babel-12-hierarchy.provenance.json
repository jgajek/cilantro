  "recovery": {
    "hierarchy": "At most 16 local reference-type layers ending at the scoped framework System.Object. Type parameters remain scoped through reordered/nested base expressions. All inherited fields are opaque; every local base initializer and static storage remains opaque and unchanged.",
    "genericConstruction": "Reconstruct only exact valid generic expressions already present in the receiver hierarchy; do not infer traits or constraints for other constructions.",
    "listMembers": "Metadata only for reviewed framework List<T> zero-argument constructor, Add(T) and get_Item(int). Preserve input assembly scopes and unknown argument identity.",
    "binder": "Run the local custom Binder.SelectMethod CIL with the original inputs and one exact reviewed candidate under normal interpreter bounds. Preserve its side effects and refuse selections outside the candidate set.",
    "limits": [
      "external base classes",
      "unreviewed collection members or reflection signatures",
      "type-dependent unknown argument traits or comparisons",
      "construction that reads or changes application instance/static state"
    ]
  },
