<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ResourceTypesProbe</AssemblyName>
    <RootNamespace>ResourceTypesProbe</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)Secrets.resources" LogicalName="ResourceTypesProbe.Secrets.resources" />
  </ItemGroup>
  <Target Name="GeneratePrimitiveResources" BeforeTargets="PrepareResourceNames">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/GenerateResources.ps1&quot; -Output &quot;$(IntermediateOutputPath)Secrets.resources&quot;" />
  </Target>
</Project>
