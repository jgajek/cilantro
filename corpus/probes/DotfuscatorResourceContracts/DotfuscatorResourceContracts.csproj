<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ContractProbe</AssemblyName>
    <RootNamespace>ContractProbe</RootNamespace>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Version>2.0.0</Version>
    <DebugType>none</DebugType>
    <ResourceLayout Condition="'$(ResourceLayout)' == ''">contract</ResourceLayout>
    <DefineConstants Condition="'$(ResourceLayout)' == 'satellite-only'">$(DefineConstants);SATELLITE_ONLY</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(ResourceLayout)' == 'satellite-only'">
    <EmbeddedResource Remove="Secrets.resx" />
  </ItemGroup>
  <Target Name="SetSatelliteContractVersion" AfterTargets="_GetAssemblyInfoFromTemplateFile">
    <ItemGroup>
      <SatelliteAssemblyAttribute Remove="System.Reflection.AssemblyVersionAttribute" />
      <SatelliteAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>1.0.0.0</_Parameter1>
      </SatelliteAssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
