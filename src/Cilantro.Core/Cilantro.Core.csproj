<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

  <!--
    The portrait of a machine the tool assumes when nobody has described one. Carried inside the
    assembly so that the common case needs no file on disk, and kept as the same JSON a caller may
    pass on the command line, so there is one format and one parser rather than two.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../profiles/windows-10-workstation.json"
                      LogicalName="Cilantro.Core.Profiles.Workstation.json" />
  </ItemGroup>

</Project>
