<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cilantro.Core\Cilantro.Core.csproj" />
  </ItemGroup>

  <!--
    The protocol is worth testing through rather than around: a server whose tools are right and
    whose framing is wrong answers nothing. The suite drives it over a pair of strings, which needs
    to reach the server itself rather than only the executable.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cilantro.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cilantro-mcp</AssemblyName>
    <RootNamespace>Cilantro.Mcp</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Product>CILantro</Product>
    <Description>Drives CILantro from an agent over the Model Context Protocol.</Description>
    <Authors>Jacob Gajek</Authors>
    <Copyright>Copyright (c) 2026 Jacob Gajek</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jgajek/cilantro</RepositoryUrl>
  </PropertyGroup>

  <!--
    Same reasoning as the CLI: an analysis VM that has never had .NET installed should be able to run
    this, and trimming is off because dnlib reaches for metadata reflectively.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
