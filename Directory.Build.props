<Project>
  <PropertyGroup>
    <!--
      What the published file says about itself in its own properties. It has to agree with
      CilantroPipeline.Version, which is what the tool prints and what it stamps on every report;
      ReleaseMetadataTests holds the two together so a download cannot be labelled one version while
      claiming another.
    -->
    <Version>0.8.0</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
